APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Set TRUSTED_PROXIES to comma-separated proxy IPs or CIDRs in production.
# Keep null for Laravel Cloud / local tunnel auto-detection.
TRUSTED_PROXIES=null

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

LOGISTICS_MAX_DELIVERY_ATTEMPTS=3
LOGISTICS_MAX_ACTIVE_DELIVERIES_PER_RIDER=10
LOGISTICS_DASHBOARD_CACHE_SECONDS=20

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional settings with defaults matching config files.
APP_PREVIOUS_KEYS=
APP_MAINTENANCE_STORE=database
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
DB_CACHE_CONNECTION=null
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=null
CACHE_STORAGE_DISK=null
CACHE_STORAGE_PATH=framework/cache/data
MEMCACHED_PERSISTENT_ID=null
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null
MEMCACHED_PORT=11211
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=null
CACHE_PREFIX=laravel-cache-

# Optional configuration variables matching config defaults.
AWS_ENDPOINT=null
AWS_URL=null
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE_RETRY_AFTER=90
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENCRYPT=yes
DB_FOREIGN_KEYS=true
DB_QUEUE=default
DB_QUEUE_CONNECTION=null
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_TABLE=jobs
DB_SOCKET=
DB_SSLMODE=prefer
DB_TRUST_SERVER_CERTIFICATE=false
DB_URL=null
LOGISTICS_DELIVERY_CODE_MAX_ATTEMPTS=5
LOGISTICS_DELIVERY_CODE_TTL_MINUTES=60
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_TRACE=false
LOG_PAPERTRAIL_HANDLER=Monolog\Handler\SyslogUdpHandler
LOG_SLACK_EMOJI=:boom:
LOG_SLACK_WEBHOOK_URL=null
LOG_STDERR_FORMATTER=null
LOG_SYSLOG_FACILITY=8
MAIL_LOG_CHANNEL=null
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_URL=null
MYSQL_ATTR_SSL_CA=null
PAPERTRAIL_PORT=null
PAPERTRAIL_URL=null
POSTMARK_API_KEY=null
POSTMARK_MESSAGE_STREAM_ID=null
QUEUE_FAILED_DRIVER=database-uuids
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_CACHE_DB=1
REDIS_CLUSTER=redis
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_PERSISTENT=false
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_URL=null
REDIS_USERNAME=null
RESEND_API_KEY=null
SESSION_CONNECTION=null
SESSION_EXPIRE_ON_CLOSE=false
SESSION_HTTP_ONLY=true
SESSION_PARTITIONED_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_STORE=null
SESSION_TABLE=sessions
SLACK_BOT_USER_DEFAULT_CHANNEL=null
SLACK_BOT_USER_OAUTH_TOKEN=null
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=null
REDIS_PREFIX=laravel-database-
SESSION_COOKIE=laravel-session
LOG_SLACK_USERNAME=Laravel
MAIL_EHLO_DOMAIN=localhost
DB_DATABASE=laravel
DB_HOST=127.0.0.1
DB_PASSWORD=
DB_PORT=3306
DB_USERNAME=root
SESSION_SECURE_COOKIE=null
